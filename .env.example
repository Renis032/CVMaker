# Which Claude to use:
#   claude-code (default) - runs your local Claude Code login, so it uses your Claude Pro/Max plan, no API billing
#   api                   - uses ANTHROPIC_API_KEY (pay-as-you-go)
CVMAKER_BACKEND=claude-code
# ANTHROPIC_API_KEY=

# Optional: JSearch on RapidAPI (Google Jobs aggregate incl. LinkedIn, Indeed, Glassdoor)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  (free tier available)
RAPIDAPI_KEY=

# Optional overrides
# CVMAKER_MODEL=claude-opus-5-5
# CLAUDE_BIN=~/.local/bin/claude
# CHROME_BIN=google-chrome
# CAREER_PAGE_CACHE_HOURS=24
