# CVMaker settings. Copy to .env and fill in what you need. Everything is optional in desktop mode.

# ---------------------------------------------------------------------------------------------------------------
# Mode
#   desktop (default) - one person's computer: no login, only answers on 127.0.0.1, each user enters their own
#                       Anthropic API key in Settings → API keys (stored encrypted on their machine)
#   server            - a hosted site with accounts (see the "server" section below and README → Hosting)
CVMAKER_MODE=desktop
# Where data lives (default: ./data in a source checkout; the desktop launcher uses the system's per-user folder)
# CVMAKER_DATA=

# Salaries are compared in EUR with the European Central Bank's daily rates, fetched once a day when a search runs
# (nothing about you is sent). 0 = never fetch; use the fixed rates built into the app.
# CVMAKER_LIVE_RATES=1

# What the app writes to its log (stderr): INFO by default. DEBUG adds tracebacks for failed tasks and sources.
# CVMAKER_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------------------------------
# Claude
#   api (default)  - the Anthropic API: the user's own key (Settings) or ANTHROPIC_API_KEY below
#   claude-code    - desktop only, for development: runs your local Claude Code login (personal use only)
CVMAKER_BACKEND=api
# Server: the operator's key, metered per plan. Desktop: a default for this computer (Settings overrides it).
# ANTHROPIC_API_KEY=
# Models per kind of work (defaults shown)
# CVMAKER_MODEL_FAST=claude-haiku-5-5
# CVMAKER_MODEL_STANDARD=claude-sonnet-5-5
# CVMAKER_MODEL_BEST=claude-opus-5-5

# ---------------------------------------------------------------------------------------------------------------
# Job sources and GitHub: server-wide defaults. Each user can set their own in Settings → API keys.
# Check the providers' terms before using these commercially (JSearch/RapidAPI and Adzuna have commercial plans).
# RAPIDAPI_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# GITHUB_TOKEN=

# Telegram bot (desktop mode): normally saved in Settings → Telegram instead.
# TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# Server mode
# CVMAKER_SECRET_KEY=            # required: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# CVMAKER_PUBLIC_URL=https://cvmaker.example.com
# CVMAKER_ALLOWED_HOSTS=         # extra host names, comma-separated
# DATABASE_URL=postgresql://cvmaker:password@db:5432/cvmaker   # default: SQLite in the data folder
# POSTGRES_PASSWORD=             # for docker-compose.yml
# CVMAKER_TASK_WORKERS=0         # 0 when separate `python -m cvmaker.worker` processes run the queue

# Plans: monthly AI tokens (input + output) on the operator's key, calls per minute, scheduled searches
# CVMAKER_FREE_TOKENS=300000
# CVMAKER_PRO_TOKENS=6000000
# CVMAKER_AI_CALLS_PER_MINUTE=12
# CVMAKER_FREE_SCHEDULED=1
# CVMAKER_PRO_SCHEDULED=10

# Email: console (prints, development), smtp, resend or postmark
# CVMAKER_MAIL=resend
# CVMAKER_MAIL_FROM=CVMaker <hello@cvmaker.example.com>
# RESEND_API_KEY=
# POSTMARK_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Google sign-in (both needed; redirect URI: <PUBLIC_URL>/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe (billing is off without STRIPE_SECRET_KEY). Webhook URL: <PUBLIC_URL>/billing/webhook with the events
# checkout.session.completed, customer.subscription.created / .updated / .deleted. Turn on Stripe Tax for EU VAT.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=

# Backups: every N hours (server default 24), copied to S3-compatible storage when S3_BUCKET is set
# CVMAKER_BACKUP_EVERY_HOURS=24
# S3_BUCKET=
# S3_PREFIX=cvmaker
# S3_ENDPOINT=                   # e.g. https://fsn1.your-objectstorage.com (Hetzner), https://s3.fr-par.scw.cloud
# S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Days a deleted account's data is kept before it is wiped (0 = wiped at once)
# CVMAKER_DELETED_RETENTION_DAYS=0

# Legal pages (/legal/privacy, /legal/terms, /legal/cookies)
# CVMAKER_OPERATOR=Your Company Ltd, address
# CVMAKER_OPERATOR_EMAIL=privacy@cvmaker.example.com
# CVMAKER_HOSTING_PROVIDER=Hetzner Online GmbH (Germany)

# ---------------------------------------------------------------------------------------------------------------
# Other
# CHROME_BIN=google-chrome
# CVMAKER_CHROME_NO_SANDBOX=1    # only inside a container that can't run Chrome's sandbox
# CVMAKER_MAX_UPLOAD_MB=15
# CAREER_PAGE_CACHE_HOURS=24
